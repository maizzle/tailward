{
  "name": "tailward",
  "version": "1.1.0",
  "description": "Convert regular CSS to Tailwind CSS v4 utility classes.",
  "license": "MIT",
  "repository": "https://github.com/maizzle/tailward",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./html": {
      "import": "./dist/html.js",
      "types": "./dist/html.d.ts"
    }
  },
  "bin": {
    "tailward": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "vitest",
    "lint": "oxlint",
    "generate": "tsx scripts/generate.ts",
    "test": "vitest run --coverage",
    "pretest": "npm run lint",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "css-select": "^7.0.0",
    "dom-serializer": "^3.1.1",
    "domhandler": "^6.0.1",
    "domutils": "^4.0.2",
    "htmlparser2": "^12.0.0",
    "postcss-value-parser": "^4.2.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.0.18",
    "oxlint": "^1.50.0",
    "tailwindcss": "^4.3.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "tailwindcss",
    "tailwind",
    "css",
    "converter",
    "css-to-tailwind",
    "utility-classes"
  ]
}
